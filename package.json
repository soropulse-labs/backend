{
  "name": "soropulse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test integration/*.test.ts",
    "smoke:testnet": "node --import tsx scripts/live-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:ingest": "tsx watch src/worker/ingest-main.ts",
    "dev:deliver": "tsx watch src/worker/deliver-main.ts",
    "dev:consumer": "tsx watch examples/ticket-consumer/main.ts",
    "start:api": "node dist/src/api/main.js",
    "start:ingest": "node dist/src/worker/ingest-main.js",
    "start:deliver": "node dist/src/worker/deliver-main.js",
    "start:consumer": "node dist/examples/ticket-consumer/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "5.2.3",
    "@stellar/stellar-sdk": "15.0.1",
    "drizzle-orm": "0.44.5",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.5",
    "eslint": "9.36.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0"
  }
}
